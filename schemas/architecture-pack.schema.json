{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/enterprise-architecture-composer/schemas/architecture-pack.schema.json",
  "title": "Enterprise Architecture Composer Architecture Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "pack", "evidence", "aliases", "guidance", "options"],
  "properties": {
    "format": { "const": "enterprise-architecture-composer/architecture-pack" },
    "formatVersion": { "const": "0.1" },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "name", "description"],
      "properties": {
        "id": { "type": "string", "pattern": "^pack\\.(industry|vendor)\\.[a-z0-9][a-z0-9.-]*$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "enum": ["industry", "vendor"] },
        "name": { "type": "string", "minLength": 3 },
        "description": { "type": "string", "minLength": 20 }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" }
    },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" }
    },
    "guidance": {
      "type": "array",
      "items": { "$ref": "#/$defs/guidance" }
    },
    "options": {
      "type": "array",
      "items": { "$ref": "#/$defs/option" }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "evidenceType", "title", "note"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "evidenceType": { "enum": ["standard", "vendor-docs", "internal-methodology", "heuristic"] },
        "title": { "type": "string", "minLength": 3 },
        "uri": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 10 }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alias", "targetId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "alias": { "type": "string", "minLength": 1 },
        "targetId": { "type": "string", "minLength": 1 }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "classification", "statement", "targetIds", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["fact", "heuristic", "vendor-mapping"] },
        "statement": { "type": "string", "minLength": 20 },
        "targetIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fitEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "sourceIds"],
      "properties": {
        "statement": { "type": "string", "minLength": 10 },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commercialPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["none", "owner-preference", "commercial"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "optionType", "targetId", "name", "fitEvidence", "commercialPreference"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "optionType": { "enum": ["system-role", "integration-pattern", "capability"] },
        "targetId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 2 },
        "vendor": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 10 },
        "fitEvidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fitEvidence" }
        },
        "commercialPreference": { "$ref": "#/$defs/commercialPreference" }
      }
    }
  }
}
