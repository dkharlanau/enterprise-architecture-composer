{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/enterprise-architecture-composer/schemas/context.schema.json",
  "title": "Enterprise Architecture Composer Context",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "industry": { "type": "string", "minLength": 1, "default": "manufacturing" },
    "operatingModel": { "type": "string", "minLength": 1, "default": "b2b" },
    "processes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["order-to-cash", "procure-to-pay", "plan-to-produce", "returns", "intercompany", "record-to-report"]
      }
    },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "countries": { "type": "integer", "minimum": 1 },
        "legalEntities": { "type": "integer", "minimum": 1 },
        "plants": { "type": "integer", "minimum": 1 },
        "warehouses": { "type": "integer", "minimum": 1 }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "multiCompany": { "type": "boolean" },
        "highVolume": { "type": "boolean" },
        "retainLegacyWms": { "type": "boolean" }
      }
    },
    "existingSystems": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["crm", "erp", "mdm", "wms", "legacy-wms", "mes", "tms", "integration", "integration-platform", "data-platform", "partner-edge"]
      }
    },
    "currentLandscape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "systems": { "type": "array", "items": { "$ref": "#/$defs/currentSystem" } },
        "integrations": { "type": "array", "items": { "$ref": "#/$defs/currentIntegration" } }
      }
    },
    "requireExplicitNfrs": {
      "type": "boolean",
      "default": false,
      "description": "When true, latency, consistency, volume, replay, ordering and offline tolerance must be explicitly confirmed globally or per integration instead of relying silently on reference defaults."
    },
    "nfrProfile": { "$ref": "#/$defs/integrationProfile" },
    "integrationProfiles": {
      "type": "object",
      "propertyNames": { "pattern": "^integration\\.[a-z0-9.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/integrationProfile" }
    },
    "architectureDecisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/architectureDecision" }
    }
  },
  "$defs": {
    "systemRoleId": {
      "enum": ["sys.crm", "sys.erp", "sys.mdm", "sys.wms", "sys.mes", "sys.tms", "sys.integration", "sys.data-platform", "sys.partner-edge"]
    },
    "migrationStrategy": { "enum": ["keep", "replace", "retire", "undecided"] },
    "currentSystem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "roleId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "roleId": { "$ref": "#/$defs/systemRoleId" },
        "strategy": { "$ref": "#/$defs/migrationStrategy" },
        "replacementRoleId": { "$ref": "#/$defs/systemRoleId" },
        "notes": { "type": "string" }
      }
    },
    "currentIntegration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "sourceSystemId", "targetSystemId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "sourceSystemId": { "type": "string", "minLength": 1 },
        "targetSystemId": { "type": "string", "minLength": 1 },
        "targetIntegrationId": { "type": "string", "pattern": "^integration\\." },
        "strategy": { "$ref": "#/$defs/migrationStrategy" },
        "notes": { "type": "string" }
      }
    },
    "integrationProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purpose": { "enum": ["business-request", "state-transfer", "business-event", "partner-document", "analytics", "replication", "command"] },
        "latency": { "enum": ["immediate", "seconds", "minutes", "hours"] },
        "consistency": { "enum": ["strong", "eventual", "snapshot"] },
        "volume": { "enum": ["low", "medium", "high", "very-high"] },
        "fanOut": { "type": "integer", "minimum": 1 },
        "ordering": { "enum": ["none", "per-key", "global"] },
        "replay": { "enum": ["not-required", "desirable", "required"] },
        "offlineTolerance": { "enum": ["none", "short", "extended"] },
        "partnerBoundary": { "type": "boolean" },
        "payloadSize": { "enum": ["small", "medium", "large", "very-large"] },
        "changeFrequency": { "enum": ["low", "medium", "high"] },
        "immediateResponse": { "type": "boolean" }
      }
    },
    "architectureDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendationId", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^decision\\." },
        "recommendationId": { "type": "string", "pattern": "^rec\\." },
        "status": { "enum": ["accepted", "rejected", "overridden"] },
        "selectedDecision": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "sourceRecommendation": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["rejected", "overridden"] } }, "required": ["status"] },
          "then": { "required": ["rationale"] }
        },
        {
          "if": { "properties": { "status": { "const": "overridden" } }, "required": ["status"] },
          "then": { "required": ["selectedDecision"] }
        }
      ]
    }
  },
  "required": ["processes"]
}
