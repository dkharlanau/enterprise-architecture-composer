{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dkharlanau.github.io/enterprise-architecture-composer/schemas/blueprint.schema.json",
  "title": "Enterprise Architecture Composer Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engineVersion", "catalogVersion", "context", "blueprint", "recommendations", "decisionRecords", "findings", "workPackages", "metrics"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "engineVersion": { "type": "string" },
    "catalogVersion": { "type": "string" },
    "context": { "type": "object" },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processes", "capabilities", "systems", "dataObjects", "integrations", "trustBoundaries"],
      "properties": {
        "processes": { "$ref": "#/$defs/objects" },
        "capabilities": { "$ref": "#/$defs/objects" },
        "systems": { "$ref": "#/$defs/objects" },
        "dataObjects": { "$ref": "#/$defs/objects" },
        "integrations": { "$ref": "#/$defs/objects" },
        "trustBoundaries": {
          "type": "array",
          "items": { "$ref": "#/$defs/trustBoundary" }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "review", "integrationDependencies"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complianceStatus", "statement"],
          "properties": {
            "complianceStatus": { "const": "not-assessed" },
            "statement": { "type": "string", "minLength": 1 }
          }
        },
        "integrationDependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string", "pattern": "^wp\\.security\\." }
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "systems", "integrations", "replacements", "dependencies", "coexistenceWindows"],
      "properties": {
        "schemaVersion": { "const": "0.1" },
        "systems": { "type": "array", "items": { "type": "object" } },
        "integrations": { "type": "array", "items": { "type": "object" } },
        "replacements": { "type": "array", "items": { "type": "object" } },
        "dependencies": { "type": "array", "items": { "type": "object" } },
        "coexistenceWindows": { "type": "array", "items": { "type": "object" } }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "decision", "confidence", "because", "ruleIds", "alternatives"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "decision": { "type": "string", "minLength": 1 },
          "confidence": { "enum": ["high", "medium", "conditional"] },
          "because": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "ruleIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "alternatives": { "type": "array", "items": { "type": "string" } },
          "objectIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "decisionRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "recommendationId", "status", "applies", "effectiveDecision", "sourceRecommendation", "currentRecommendation"],
        "properties": {
          "id": { "type": "string", "pattern": "^decision\\." },
          "recommendationId": { "type": "string", "pattern": "^rec\\." },
          "status": { "enum": ["accepted", "rejected", "overridden"] },
          "applies": { "type": "boolean" },
          "effectiveDecision": { "type": ["string", "null"] },
          "selectedDecision": { "type": "string" },
          "rationale": { "type": "string" },
          "sourceRecommendation": { "type": ["object", "null"] },
          "currentRecommendation": { "type": ["object", "null"] }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "kind", "ruleIds", "objectIds", "message", "nextDecision"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "enum": ["info", "warning", "error"] },
          "kind": { "type": "string" },
          "ruleIds": { "type": "array", "items": { "type": "string" } },
          "objectIds": { "type": "array", "items": { "type": "string" } },
          "message": { "type": "string" },
          "nextDecision": { "type": "string" }
        }
      }
    },
    "workPackages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "phase", "title", "mandatory", "dependsOn", "sourceIds"],
        "properties": {
          "id": { "type": "string" },
          "phase": { "type": "string" },
          "title": { "type": "string" },
          "mandatory": { "type": "boolean" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "sourceIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "metrics": { "type": "object" }
  },
  "$defs": {
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trustBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "name", "boundaryType", "description", "integrationIds", "systemIds", "dataObjectIds", "ruleIds", "source"],
      "properties": {
        "id": { "type": "string", "pattern": "^trust\\." },
        "kind": { "const": "trust-boundary" },
        "name": { "type": "string", "minLength": 1 },
        "boundaryType": { "enum": ["external-partner", "public-api", "private-api", "identity", "privileged", "sensitive-data", "residency"] },
        "description": { "type": "string", "minLength": 1 },
        "integrationIds": { "type": "array", "items": { "type": "string", "pattern": "^integration\\." } },
        "systemIds": { "type": "array", "items": { "type": "string", "pattern": "^sys\\." } },
        "dataObjectIds": { "type": "array", "items": { "type": "string", "pattern": "^data\\." } },
        "ruleIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
