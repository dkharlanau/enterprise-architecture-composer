{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "manifestVersion": "0.1",
  "product": {
    "id": "enterprise-architecture-composer",
    "name": "Enterprise Architecture Composer",
    "status": "public-alpha",
    "boundary": "Deterministic architecture synthesis and review. It is not a CMDB, process repository, diagram editor, architecture approval authority, or compliance engine.",
    "publicUrl": "https://dkharlanau.github.io/enterprise-architecture-composer/",
    "repository": "https://github.com/dkharlanau/enterprise-architecture-composer"
  },
  "capabilities": [
    "compose target architecture from structured business context",
    "compare deterministic scenarios and architecture deltas",
    "model current-transition-target application replacement",
    "evaluate integration patterns from explicit NFR drivers",
    "surface architecture quality and security trust-boundary decisions",
    "generate delivery work packages and dependency waves",
    "export reviewable bundles, reports, visual projections, and downstream starter artifacts",
    "load advisory industry and vendor architecture packs without mutating core rules"
  ],
  "publicInterfaces": {
    "browser": {
      "url": "https://dkharlanau.github.io/enterprise-architecture-composer/",
      "backendRequired": false
    },
    "cli": {
      "primary": "node bin/eac.mjs",
      "commands": [
        "compose",
        "transition",
        "compare",
        "integration",
        "metrics",
        "roadmap",
        "bundle",
        "report",
        "visual",
        "process-starter",
        "interface-proposal",
        "interface-adopt"
      ],
      "additional": [
        "node bin/eac-import.mjs",
        "node bin/eac-packs.mjs",
        "node bin/eac-options.mjs",
        "node bin/eac-review.mjs",
        "node bin/eac-provenance.mjs"
      ]
    }
  },
  "contracts": {
    "context": "./schemas/context.schema.json",
    "blueprint": "./schemas/blueprint.schema.json",
    "architecturePack": "./schemas/architecture-pack.schema.json"
  },
  "referenceScenarios": [
    "./examples/scenarios/o2c-starter.context.json",
    "./examples/scenarios/global-b2b-manufacturer.context.json",
    "./examples/scenarios/partner-procurement.context.json",
    "./examples/scenarios/legacy-wms-replacement.context.json",
    "./examples/scenarios/security-boundaries.context.json"
  ],
  "relatedProjects": [
    {
      "id": "process-as-code",
      "relationship": "adopted process semantics",
      "repository": "https://github.com/dkharlanau/process-as-code"
    },
    {
      "id": "interface-as-code",
      "relationship": "adopted operational integration contracts",
      "repository": "https://github.com/dkharlanau/interface-as-code"
    },
    {
      "id": "mapping-as-code",
      "relationship": "field and value transformation semantics",
      "repository": "https://github.com/dkharlanau/mapping-as-code"
    },
    {
      "id": "enterprise-change-graph",
      "relationship": "change-specific impact analysis",
      "repository": "https://github.com/dkharlanau/enterprise-change-graph"
    },
    {
      "id": "visual-workbench",
      "relationship": "presentation and rendering",
      "repository": "https://github.com/dkharlanau/visual-workbench"
    }
  ],
  "safety": {
    "deterministicCore": true,
    "aiProviderRequired": false,
    "complianceClaims": false,
    "clientDataExpected": false,
    "notes": "Unknown or conflicting architecture facts are surfaced for review rather than guessed. Public examples are synthetic."
  }
}
